# Route Engine configuration.
#
# The current pipeline is a credential-free mock (see app/engine.py), so no
# secrets are required to run it. These variables are placeholders for the real
# pipeline described in docs/ARCHITECTURE.md §7.

# Optional hosted vision-model provider key. If unset, the engine uses its
# built-in local/mock fallback so it runs with zero external credentials.
# VISION_API_KEY=

# Optional Overpass API endpoint override for OSM graph fetching.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
